{
 "id": "cdsl-freeze-master",
 "title": "Online freeze master report (CDSL DPE6)",
 "party": "CDSL",
 "direction": "in",
 "when": "As it arrives (several times a day)",
 "purpose": "Every freeze on the DP's accounts: set up, unfrozen, cancelled, released or failed, for the whole account or one ISIN, in full or for a quantity, with the reason, the authority and the order.",
 "names": [
  "\\d*DPE6.*"
 ],
 "compress": "none",
 "format": "delimited",
 "delimiter": "~",
 "header": false,
 "crlf": true,
 "final_eol": true,
 "confirmed": true,
