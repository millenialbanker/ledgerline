   "name": "Date",
   "type": "date",
   "layout": "02-Jan-2006"
  },
  {
   "name": "ClientCode",
   "type": "str"
  },
  {
   "name": "VaRPlusELM",
   "type": "dec"
  },
  {
   "name": "MinimumMargin",
   "type": "dec"
  },
  {
   "name": "AdditionalMargin",
   "type": "dec"
  },
  {
   "name": "MTMLoss",
   "type": "dec",
   "note": "MTM profit is shown as 0"
  },
  {
   "name": "EODTotalActualMargin",
   "type": "dec",
   "note": "VaR + ELM + additional + MTM"
  },
  {
   "name": "EODMarginToCollect",
   "type": "dec",
   "note": "Minimum margin + additional + MTM"
  },
  {
   "name": "PeakMarginToCollect",
   "type": "dec"
  },
  {
