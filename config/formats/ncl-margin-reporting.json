 "names": [
  "C_MRG_TM_\\d{8}_\\d+\\.csv",
  "C_MRG_TM_\\d+_\\d+\\.csv"
 ],
 "template": "C_MRG_TM_{date:02012006}_{seq:2}.csv",
 "columns": [
