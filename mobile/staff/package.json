{
  "name": "ledgerline-staff-app",
  "version": "1.0.0",
  "private": true,
  "description": "Ledgerline staff app: a Capacitor shell around the /m/ pages a Ledgerline server serves.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "configure": "node scripts/configure.mjs",
